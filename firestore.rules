rules_version = '2';
// Updated rules to allow buyers to rate seller stores
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isUserDocumentExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function isAdmin() {
      return isSignedIn() && isUserDocumentExists(request.auth.uid) && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin');
    }

    function isUser() {
      return isSignedIn() && isUserDocumentExists(request.auth.uid) && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'user' || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'User');
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ['user', 'seller']
        && request.resource.data.email is string
        && request.resource.data.name is string;

      // Updates are allowed when:
      // - an admin (full override), OR
      // - the account owner updating their profile (but not toggling deleted except to perform a constrained soft-delete), OR
      // - a buyer writing storeRatings to a seller's profile (existing behavior)
      allow update: if isAdmin()
        || (
          request.auth.uid == userId
          // basic ownership sanity checks
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          && request.resource.data.name is string
          && (
            // Owner performing a constrained soft-delete: set deleted=true and provide deletedAt timestamp, and change ONLY these keys
            (
              request.resource.data.deleted == true
              && request.resource.data.deletedAt is timestamp
              && request.resource.data.deletedBy == 'user'
              // Only the changed keys may be 'deleted', 'deletedAt', and 'deletedBy' (use diff.changedKeys)
              && request.resource.data.diff(resource.data).changedKeys().hasOnly(['deleted', 'deletedAt', 'deletedBy'])
            )
            ||
            // Owner updating profile fields but NOT touching the deleted flag
            (request.resource.data.deleted == resource.data.deleted)
          )
        )
        // Allow only buyers (user role) to update storeRatings on other user docs
        || (isUser()
            && request.auth.uid != userId
            && ('storeRatings' in request.resource.data));

      // Prevent clients from performing hard deletes; only admins (or server-side processes) can remove documents entirely.
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /orders/{orderId} {
      function isOrderOwner() {
        return isSignedIn() && request.auth.uid == resource.data.userId;
      }
      function isOrderSeller() {
        return isSignedIn() && request.auth.uid == resource.data.sellerId;
      }
      allow read: if isAdmin() || isOrderOwner() || isOrderSeller();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.sellerId is string
        && request.resource.data.products is list
        && request.resource.data.totalAmount is number;
      allow update: if isAdmin()
        || isOrderSeller()
        || (isOrderOwner() && request.resource.data.status == 'Cancelled');
      allow delete: if false;
    }

    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.sellerId is string
        && request.resource.data.productId is string
        && request.resource.data.reason is string;
      allow read: if isAdmin() || request.auth.uid == resource.data.reportedBy;
      allow update, delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.receiverId in request.resource.data.participants
        && request.resource.data.message is string;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.userId is string
        && request.resource.data.message is string;
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.isRead == true;
      allow delete: if isSignedIn()
        && (request.auth.uid == resource.data.userId || isAdmin());
    }
  }
}
