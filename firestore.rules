rules_version = '2';
// Updated rules: buyers can rate / re-rate seller stores and products (unlimited)
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isUserDocumentExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function isAdmin() {
      return isSignedIn() && isUserDocumentExists(request.auth.uid) && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin');
    }

    function isUser() {
      return isSignedIn() && isUserDocumentExists(request.auth.uid) && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'user' || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'User');
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ['user', 'seller']
        && request.resource.data.email is string
        && request.resource.data.name is string;

      // Updates are allowed when:
      // - an admin (full override), OR
      // - the account owner updating their own profile (role and email can't change), OR
      // - a buyer rating a seller's store. Only the rating fields may change,
      //   and there is no limit on how many times a buyer can re-rate.
      allow update: if isAdmin()
        || (
          request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email
        )
        || (
          isUser()
          && request.auth.uid != userId
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['storeRatings', 'averageRating', 'ratingCount'])
        );

      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      function isProductSeller() {
        return isSignedIn() && request.auth.uid == resource.data.sellerId;
      }

      allow read: if true;

      // Sellers create their own products (admins can create any)
      allow create: if isAdmin()
        || (isSignedIn() && request.resource.data.sellerId == request.auth.uid);

      // Update by: admin, the product's seller, or a buyer rating the product.
      // Buyers can only touch the rating fields, and can re-rate unlimited times.
      allow update: if isAdmin()
        || isProductSeller()
        || (
          isUser()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['ratings', 'averageRating', 'ratingCount'])
        );

      allow delete: if isAdmin() || isProductSeller();
    }

    match /orders/{orderId} {
      function isOrderOwner() {
        return isSignedIn() && request.auth.uid == resource.data.userId;
      }
      function isOrderSeller() {
        return isSignedIn() && request.auth.uid == resource.data.sellerId;
      }
      allow read: if isAdmin() || isOrderOwner() || isOrderSeller();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.sellerId is string
        && request.resource.data.products is list
        && request.resource.data.totalAmount is number;
      allow update: if isAdmin()
        || isOrderSeller()
        || (isOrderOwner() && (
            request.resource.data.status == 'Cancelled' ||
            request.resource.data.paymentStatus == 'Paid Online (GCash)'
          ));
      allow delete: if false;
    }

    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.sellerId is string
        && request.resource.data.productId is string
        && request.resource.data.reason is string;
      allow read: if isAdmin() || request.auth.uid == resource.data.reportedBy;
      allow update, delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.receiverId in request.resource.data.participants
        && request.resource.data.message is string;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.userId is string
        && request.resource.data.message is string;
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.isRead == true;
      allow delete: if isSignedIn()
        && (request.auth.uid == resource.data.userId || isAdmin());
    }
  }
}
